# ---- Server ----
HOST=127.0.0.1
PORT=8787
DB_PATH=data/constitbrief.sqlite3
# Session cookies are Secure (HTTPS-only). Set false ONLY for http://localhost development.
COOKIE_SECURE=true
SESSION_HOURS=10
# Server-side interaction drafts (notes + record) are deleted after this many hours (decision D8).
DRAFT_RETENTION_HOURS=72

# ---- Analysis provider (decision D6) ----
# "rules" keeps everything on this server. "jev" sends PII-redacted notes to OpenRouter (TypeSafe Jev).
ANALYSIS_PROVIDER=rules
OPENROUTER_API_KEY=
JEV_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=3
# Optional chat model to polish acknowledgement drafts (decision D7). Blank = templates only.
GENERATE_MODEL=

# ---- Jotform handoff ----
# Override only to point a staging deployment at a cloned test form.
JOTFORM_FORM_ID=252413844700855
# Pre-select the enquiry option in the form link (non-sensitive).
JOTFORM_PREFILL_TYPE=true
# Also put name/phone/email/address in the link (lands in browser history) - decision D9.
JOTFORM_PREFILL_CONTACT=false
# Optional READ-ONLY key so staff can confirm a submission by its reference (decision D10).
JOTFORM_API_KEY=
JOTFORM_API_BASE=https://api.jotform.com

# ---- Government site search (optional) ----
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SEARCH_CACHE_HOURS=24
SEARCH_DOMAINS=servicesaustralia.gov.au,homeaffairs.gov.au,myagedcare.gov.au,ndis.gov.au,ato.gov.au,dva.gov.au,my.gov.au

# ---- Drafts ----
OFFICE_SIGNOFF=Team Moreton
OFFICE_NAME=Office of Julie-Ann Campbell MP, Federal Member for Moreton
OFFICE_PHONE=
OFFICE_EMAIL=
