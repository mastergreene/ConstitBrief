# ---- Server ----
HOST=127.0.0.1
PORT=8787
# SQLite file (created on first run)
DB_PATH=data/casework.sqlite3
# Recent case drafts contain constituent PII; they are purged after this many days.
CASE_RETENTION_DAYS=30

# Shared access code for the API. STRONGLY recommended whenever the app is
# reachable from anything other than localhost. Staff enter it once per device.
APP_ACCESS_TOKEN=

# ---- OpenRouter (Jev decision gate + optional draft polishing) ----
OPENROUTER_API_KEY=
JEV_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=6
# Optional chat model used to polish drafts. Leave blank for template-only drafts.
# Any OpenRouter chat model id works, e.g. an anthropic/... model.
GENERATE_MODEL=

# ---- Live gov search (pick one; Brave is tried first) ----
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SEARCH_CACHE_HOURS=24
# Comma-separated allow-list. Results from any other domain are dropped.
SEARCH_DOMAINS=servicesaustralia.gov.au,homeaffairs.gov.au,myagedcare.gov.au,ndis.gov.au,ato.gov.au,dva.gov.au,my.gov.au

# ---- Jotform ----
JOTFORM_URL=https://form.jotform.com/252413844700855
# JSON map of category id -> exact option text of the "typeA" dropdown on the form.
# Must match the form's option labels exactly or Jotform ignores the value.
JOTFORM_TYPEA_MAP=

# ---- Office details used in drafts (optional) ----
OFFICE_SIGNOFF=Team Moreton
OFFICE_NAME=Office of Julie-Ann Campbell MP, Federal Member for Moreton
OFFICE_PHONE=
OFFICE_EMAIL=
